# NetriBeat backend configuration. Copy to `.env` (same folder) and fill in.
# Never commit .env. Every value marked CHANGE ME must be changed.

ENVIRONMENT=development            # development | production

# PostgreSQL (asyncpg driver). Password must match infra/.env POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://netribeat:CHANGE_ME_DB_PASSWORD@localhost:5432/netribeat
REDIS_URL=redis://localhost:6379/0

# Two DIFFERENT random secrets, at least 32 characters each. Generate each with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_RUN_THE_COMMAND_ABOVE
OTP_PEPPER=CHANGE_ME_RUN_THE_COMMAND_AGAIN

# Browser
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false                # must be true in production (HTTPS)

# Email: console (prints mail incl. codes to this terminal), file (writes .eml files to
# EMAIL_FILE_DIR), or smtp (real delivery). Production requires smtp.
EMAIL_BACKEND=console
EMAIL_FROM=NetriBeat <no-reply@localhost>
# EMAIL_FILE_DIR=./var/mail
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SMTP_SSL=false                   # true for implicit TLS on port 465

# Optional tuning (defaults shown)
# PASSWORD_MIN_LENGTH=12           # never below 8
# HIBP_CHECK_ENABLED=false         # breached-password check (k-anonymity, needs internet)
# ACCESS_TOKEN_MINUTES=15
# SESSION_HOURS_DEFAULT=12
# SESSION_DAYS_REMEMBER=30
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# LOG_LEVEL=INFO

# --- Recordings ---
# inline: analysis runs inside the API process (simple development; no worker needed)
# arq:    durable background jobs; also run `uv run arq netribeat.sessions.worker.WorkerSettings`
#         (required in production)
JOB_BACKEND=inline
STORAGE_DIR=./var/storage            # uploaded files are stored here under opaque names
# MAX_UPLOAD_FILE_BYTES=52428800     # 50 MB per file
# MAX_UPLOAD_FILES=10
# ANALYSIS_TIMEOUT_SECONDS=600
