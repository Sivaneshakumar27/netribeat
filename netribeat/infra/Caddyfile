# NetriBeat edge server. Environment:
#   DOMAIN        your public hostname, e.g. app.example.org (DNS A/AAAA record → this server)
#   ACME_EMAIL    contact for Let's Encrypt expiry notices
#   API_UPSTREAM  host:port of the FastAPI container (default api:8000)
#   WEB_ROOT      built frontend (default /srv)
{
	email {$ACME_EMAIL}
	# No trusted_proxies: Caddy faces the internet directly, so it discards any
	# client-supplied X-Forwarded-For and sends the real client IP to the API.
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Recording upload: up to 10 files × 50 MB (the API enforces the exact limits).
	handle /api/v1/sessions {
		request_body {
			max_size 512MB
		}
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	# API: everything under /api goes to FastAPI (which sets its own strict CSP).
	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy {$API_UPSTREAM:api:8000} {
			health_uri /api/v1/health
			health_interval 15s
		}
	}

	# Frontend (single-page app).
	handle {
		root * {$WEB_ROOT:/srv}
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		# Never log cookies or authorization headers.
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
				request>uri query {
					delete code
					delete token
				}
			}
		}
	}
}
