# Production settings for docker-compose.prod.yml. Copy to `.env.production` ON THE SERVER
# (never commit it). Generate every secret with:
#   openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48
# (or on Windows: python -c "import secrets; print(secrets.token_urlsafe(48))")

# Your public hostname. Create a DNS A record pointing it at the server's IP first.
DOMAIN=app.example.org
ACME_EMAIL=you@example.org          # Let's Encrypt notices

POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_48_RANDOM_CHARS
OTP_PEPPER=CHANGE_ME_DIFFERENT_48_RANDOM_CHARS

# Real email delivery (required in production). Any SMTP provider works.
EMAIL_FROM=NetriBeat <no-reply@example.org>
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_STARTTLS=true
SMTP_SSL=false                      # true with SMTP_PORT=465

# Optional
# PASSWORD_MIN_LENGTH=12
# HIBP_CHECK_ENABLED=true           # breached-password check (outbound HTTPS to api.pwnedpasswords.com)
# LOG_LEVEL=INFO
